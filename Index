  <div class="panel"><div class="detail-tabs" id="profileTabs"><button class="active" data-tab="dados">Dados cadastrais</button><button data-tab="resumo">Resumo</button><button data-tab="timeline">Linha do tempo</button><button data-tab="gratificacoes">Treinamentos</button><button data-tab="tmi">TMI</button><button data-tab="acoes_cs">Ações CS</button><button data-tab="checklists">Checklists</button><button data-tab="pce">PCE</button><button data-tab="mru_cs">MRU CS</button></div><div class="detail-body" id="profileContent"><div class="empty">Carregando ficha...</div></div></div>
</section>
