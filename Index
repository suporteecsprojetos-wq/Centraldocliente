<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
const TABLES=[
 {key:'gratificacoes',label:'Treinamentos',expected:551},
 {key:'tmi',label:'TMI',expected:80},
 {key:'acoes_cs',label:'Ações de CS',expected:538},
 {key:'checklists',label:'Checklists',expected:58},
 {key:'pce',label:'PCE',expected:651},
 {key:'mru_cs',label:'MRU CS',expected:13}
];
let cfg=JSON.parse(localStorage.getItem('central_fortes_cfg')||'{}'),clients=[],data={},counts={},filtered=[],page=1,pageSize=15,current=null,profileCache={},supabaseClient=null,authSession=null;
const $=id=>document.getElementById(id);
const esc=v=>String(v??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const val=(o,keys)=>{for(const k of keys){if(o&&o[k]!==null&&o[k]!==undefined&&o[k]!=='')return o[k]}return '—'};
const date=v=>{if(!v||v==='—')return '—';let s=String(v);let d=new Date(s.length===10?s+'T00:00:00':s);return isNaN(d)?esc(s):d.toLocaleDateString('pt-BR')};
const money=v=>{if(v===null||v===undefined||v==='')return '—';let n=Number(v);return Number.isFinite(n)?n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}):esc(v)};
function toast(m){$('toast').textContent=m;$('toast').classList.remove('hidden');setTimeout(()=>$('toast').classList.add('hidden'),4000)}
function status(ok,msg){$('connDot').className='dot'+(ok?' ok':'');$('connText').textContent=msg}
function show(id){document.querySelectorAll('.view').forEach(v=>v.classList.toggle('active',v.id===id));document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===id));$('crumb').textContent=({dashboard:'Visão geral',analises:'Dashboard analítico',clientes:'Base de clientes',historico:'Histórico 360°',acoes_cs:'Ações de CS',gratificacoes:'Treinamentos',tmi:'TMI',checklists:'Checklists',pce:'Participação em eventos',mru_cs:'MRU CS',integracoes:'Integrações',config:'Configurações',ficha:'Ficha 360°'})[id]||id}
function configureSupabase(){if(!cfg.url||!cfg.key)throw new Error('Informe a URL e a chave pública do Supabase.');if(!window.supabase?.createClient)throw new Error('Não foi possível carregar a biblioteca de autenticação. Verifique sua conexão com a internet.');supabaseClient=window.supabase.createClient(cfg.url,cfg.key,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});return supabaseClient}
function authHeaders(){if(!authSession?.access_token)throw new Error('Sua sessão expirou. Faça login novamente.');return {apikey:cfg.key,Authorization:'Bearer '+authSession.access_token,Accept:'application/json'}}
async function api(table,query='select=*'){if(!cfg.url||!cfg.key)throw new Error('Configure o Supabase.');let u=cfg.url.replace(/\/$/,'')+'/rest/v1/'+table+'?'+query;let r=await fetch(u,{headers:authHeaders()});if(!r.ok)throw new Error(table+': '+(await r.text()).slice(0,240));return r.json()}
async function countTable(t){let u=cfg.url.replace(/\/$/,'')+'/rest/v1/'+t+'?select=id';let r=await fetch(u,{headers:{...authHeaders(),Prefer:'count=exact',Range:'0-0'}});if(!r.ok)throw new Error('Não foi possível contar '+t);let cr=r.headers.get('content-range');return cr&&cr.includes('/')?Number(cr.split('/')[1]):0}
async function load(){if(!cfg.url||!cfg.key){status(false,'Supabase não configurado');return}status(false,'Conectando...');try{clients=await api('clientes','select=*&order=razao_social.asc&limit=2000');for(const t of TABLES){let [rows,n]=await Promise.all([api(t.key,'select=*&limit=2000'),countTable(t.key)]);data[t.key]=rows;counts[t.key]=n}status(true,'Supabase conectado');renderAll()}catch(e){status(false,'Falha na conexão');toast('Erro ao consultar o Supabase: '+e.message);console.error(e)}}
function situation(c){return String(val(c,['situacao'])).toUpperCase()}
function renderAll(){renderDashboard();renderClientFilters();applyClientFilters();renderDataTables();renderAnalysis();renderIntegration()}
function renderDashboard(){let active=clients.filter(c=>!situation(c).includes('CANCEL')).length,cancel=clients.length-active,total=Object.values(counts).reduce((a,b)=>a+b,0);$('kClients').textContent=clients.length.toLocaleString('pt-BR');$('kActive').textContent=active.toLocaleString('pt-BR');$('kCanceled').textContent=cancel.toLocaleString('pt-BR');$('kHistory').textContent=total.toLocaleString('pt-BR');let groups={};clients.forEach(c=>{let s=val(c,['situacao']);groups[s]=(groups[s]||0)+1});$('situationChart').innerHTML=Object.entries(groups).sort((a,b)=>b[1]-a[1]).map(([s,n])=>`<div class="bar-row"><span>${esc(s)}</span><div class="bar-track"><i style="width:${clients.length?n/clients.length*100:0}%"></i></div><b>${n}</b></div>`).join('')||'<div class="empty">Nenhum cadastro.</div>';$('historyCounts').innerHTML=TABLES.map(t=>`<div class="history-item"><div class="history-icon">${t.key==='pce'?'☆':'▤'}</div><div style="flex:1"><strong>${t.label}</strong><small>${(counts[t.key]??t.expected).toLocaleString('pt-BR')} registros</small></div><b style="font-size:11px">${(counts[t.key]??t.expected).toLocaleString('pt-BR')}</b></div>`).join('');$('recentClients').innerHTML=clients.slice(0,7).map(c=>clientRow(c,true)).join('')||'<tr><td colspan="6" class="empty">Nenhum cliente cadastrado.</td></tr>'}
function clientRow(c,compact=false){let name=val(c,['razao_social','nome_fantasia']),sit=situation(c),code=val(c,['codigo']);return `<tr><td><span class="client-name">${esc(name)}</span><span class="sub">${esc(val(c,['nome_fantasia']))}</span></td><td>${esc(code)}</td>${compact?'':`<td>${esc(val(c,['cnpj']))}</td>`}<td>${esc(val(c,['cidade']))}</td><td>${esc(val(c,['segmento']))}</td><td><span class="pill ${sit.includes('CANCEL')?'cancel':''}">${esc(val(c,['situacao']))}</span></td><td><button class="link" data-open="${esc(c.id)}">Abrir ficha →</button></td></tr>`}
function renderClientFilters(){let seg=[...new Set(clients.map(c=>val(c,['segmento'])).filter(x=>x!=='—'))].sort();$('filterSegment').innerHTML='<option value="">Todos os segmentos</option>'+seg.map(s=>`<option>${esc(s)}</option>`).join('')}
function applyClientFilters(){let q=$('search').value.toLowerCase().trim(),sit=$('filterSituation').value,seg=$('filterSegment').value;filtered=clients.filter(c=>[c.codigo,c.razao_social,c.nome_fantasia,c.cnpj,c.cidade].join(' ').toLowerCase().includes(q)&&(!sit||situation(c).includes(sit))&&(!seg||c.segmento===seg));page=1;renderClients()}
function renderClients(){let start=(page-1)*pageSize,items=filtered.slice(start,start+pageSize);$('clientRows').innerHTML=items.map(c=>clientRow(c)).join('')||'<tr><td colspan="7" class="empty">Nenhum cliente encontrado.</td></tr>';$('clientCount').textContent=filtered.length+' clientes';$('pageInfo').textContent=filtered.length?`Exibindo ${start+1}–${Math.min(start+pageSize,filtered.length)} de ${filtered.length}`:'Nenhum registro';$('prev').disabled=page===1;$('next').disabled=start+pageSize>=filtered.length}
function renderAnalysis(){for(const [id,key] of [['aAcoes','acoes_cs'],['aGrat','gratificacoes'],['aTmi','tmi'],['aPce','pce']])$(id).textContent=(counts[key]??TABLES.find(t=>t.key===key).expected).toLocaleString('pt-BR');let max=Math.max(1,...TABLES.map(t=>counts[t.key]??t.expected));$('analysisBars').innerHTML=TABLES.map(t=>{let n=counts[t.key]??t.expected;return `<div class="bar-row"><span>${t.label}</span><div class="bar-track"><i style="width:${n/max*100}%"></i></div><b>${n}</b></div>`}).join('');let seg={};clients.forEach(c=>{let s=val(c,['segmento']);seg[s]=(seg[s]||0)+1});$('segmentBars').innerHTML=Object.entries(seg).sort((a,b)=>b[1]-a[1]).slice(0,10).map(([s,n])=>`<div class="bar-row"><span>${esc(s)}</span><div class="bar-track"><i style="width:${n/Math.max(1,clients.length)*100}%"></i></div><b>${n}</b></div>`).join('')||'<div class="empty">Sem dados de segmento.</div>'}
function renderIntegration(){$('integrationCounts').innerHTML=[{key:'clientes',label:'Clientes',n:clients.length},...TABLES.map(t=>({key:t.key,label:t.label,n:counts[t.key]??t.expected}))].map(x=>`<div class="history-item" style="padding:7px 0;border-bottom:1px solid #f0f0f2"><div class="history-icon">✓</div><div style="flex:1"><strong>${x.label}</strong><small>Tabela ${x.key}</small></div><b style="font-size:11px">${x.n.toLocaleString('pt-BR')}</b></div>`).join('')}
const columns={
acoes_cs:[['Data',['data_acao']],['Código',['codigo_cliente','codigo']],['Razão social',['razao_social']],['Responsável',['quem_realizou']],['Ação',['acao']],['Especificação',['especificacao']],['Status',['status']]],
gratificacoes:[['Data',['data_treinamento']],['Código',['codigo_cliente','codigo']],['Razão social',['razao_social']],['Técnico',['tecnico']],['Sistema',['sistema']],['Modalidade',['modalidade']],['Horas',['horas_totais']],['Bonificação',['bonificacao']]],
tmi:[['Código',['codigo_cliente','codigo']],['Razão social',['razao_social']],['Segmento',['segmento']],['Contratou',['contratou']],['Início',['data_inicio']],['Término',['data_termino']],['Resultado',['resultado']]],
checklists:[['Data',['data_acao']],['Código',['codigo_cliente','codigo']],['Razão social',['razao_social']],['Responsável',['quem_realizou']],['Especificação',['especificacao']],['Status',['status']],['Pontos',['pontos']]],
pce:[['Data',['data_evento']],['Código',['codigo_cliente','codigo']],['Razão social',['razao_social']],['Participante',['participante']],['Subsistema',['subsistema']],['Tema',['tema']],['Modalidade',['modalidade']]],
mru_cs:[['Negociação',['data_negociacao']],['Código',['codigo_cliente','codigo']],['Razão social',['razao_social']],['Coordenador',['coordenador']],['Vendedor',['vendedor']],['Sistema',['sistema']],['Valor',['valor']],['Recebido?',['recebido']]]
};
function renderDataTables(){for(const t of TABLES){let rows=data[t.key]||[],q=document.querySelector(`[data-table-search="${t.key}"]`)?.value?.toLowerCase()||'';rows=rows.filter(r=>JSON.stringify(r).toLowerCase().includes(q));let cols=columns[t.key],el=$('rows_'+t.key);if(!el)continue;el.innerHTML=rows.slice(0,250).map(r=>'<tr>'+cols.map(([label,keys])=>{let v=val(r,keys);if(label.toLowerCase().includes('data')||label==='Início'||label==='Término'||label==='Negociação')v=date(v);if(label==='Valor'||label==='Bonificação')v=money(v);return `<td>${esc(v)}</td>`}).join('')+'</tr>').join('')||`<tr><td colspan="${cols.length}" class="empty">Nenhum registro encontrado.</td></tr>`}}
function profileData(c){let f=[['Código',['codigo']],['Razão social',['razao_social']],['Nome fantasia',['nome_fantasia']],['CNPJ',['cnpj']],['Situação',['situacao']],['Cidade',['cidade']],['Segmento',['segmento']],['E-mail',['email']],['Celular',['celular']],['Telefones adicionais',['telefones_adicionais']],['Visitado?',['visitado']],['Quantas vezes?',['quantas_vezes']],['Última visita',['data_ultima_visita']]];$('profileContent').innerHTML='<div class="info-grid">'+f.map(([l,k])=>`<div class="info"><small>${l}</small><strong>${esc(val(c,k))}</strong></div>`).join('')+'</div>'}
function recordsFor(key){return (data[key]||[]).filter(r=>String(r.cliente_id||'')===String(current.id))}
function recDate(r){return val(r,['data_treinamento','data_acao','data_evento','data_negociacao','data_inicio','data_pagamento'])}
function openProfile(id){current=clients.find(c=>String(c.id)===String(id));if(!current)return;profileCache={};$('clientTitle').textContent=val(current,['razao_social','nome_fantasia']);$('clientSubtitle').textContent='Código '+val(current,['codigo'])+' · CNPJ '+val(current,['cnpj']);$('clientAvatar').textContent=String(val(current,['razao_social','nome_fantasia'])).charAt(0).toUpperCase();$('clientStatus').innerHTML=`<span class="pill ${situation(current).includes('CANCEL')?'cancel':''}">${esc(val(current,['situacao']))}</span>`;show('ficha');document.querySelectorAll('#profileTabs button').forEach(b=>b.classList.toggle('active',b.dataset.tab==='dados'));profileData(current)}
function showProfileTab(tab){document.querySelectorAll('#profileTabs button').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));let el=$('profileContent');if(tab==='dados'){profileData(current);return}if(tab==='resumo'){el.innerHTML='<div class="grid mini-kpis">'+TABLES.map(t=>`<div class="mini-kpi"><span>${t.label}</span><b>${recordsFor(t.key).length}</b></div>`).join('')+'</div><p class="muted" style="font-size:10px">Contagem de registros vinculados ao cliente pelo identificador cliente_id.</p>';return}let all=tab==='timeline'?TABLES.flatMap(t=>recordsFor(t.key).map(r=>({key:t.key,label:t.label,row:r,date:recDate(r)}))).sort((a,b)=>new Date(b.date)-new Date(a.date)):recordsFor(tab).map(r=>({key:tab,label:TABLES.find(t=>t.key===tab)?.label,row:r,date:recDate(r)}));if(tab==='timeline'){el.innerHTML=all.length?'<div class="timeline">'+all.map(e=>`<div class="event"><b>${esc(e.label)}</b><p>${esc(val(e.row,['descricao_acao','descricao','tema','sistema','tipo','especificacao','observacao']))}</p><small>${date(e.date)}</small></div>`).join('')+'</div>':'<div class="empty">Nenhum histórico vinculado a este cliente.</div>';return}let cols=columns[tab]||[];el.innerHTML=all.length?all.map((e,i)=>`<div class="panel" style="padding:13px;margin-bottom:10px;box-shadow:none"><b style="font-size:11px">Registro ${i+1}</b><div class="info-grid" style="margin-top:10px">${cols.map(([l,k])=>`<div class="info"><small>${l}</small><strong>${esc(val(e.row,k))}</strong></div>`).join('')}</div></div>`).join(''):'<div class="empty">Nenhum registro encontrado nesta base para o cliente.</div>'}
function findHistory(){let q=$('historySearch').value.toLowerCase().trim();let c=clients.find(x=>String(x.codigo||'').toLowerCase()===q||String(x.razao_social||'').toLowerCase().includes(q)||String(x.nome_fantasia||'').toLowerCase().includes(q));if(!c){$('historyResult').innerHTML='<div class="empty">Cliente não encontrado na base.</div>';return}current=c;let all=TABLES.flatMap(t=>(data[t.key]||[]).filter(r=>String(r.cliente_id||'')===String(c.id)).map(r=>({label:t.label,row:r,date:recDate(r)}))).sort((a,b)=>new Date(b.date)-new Date(a.date));$('historyResult').innerHTML=`<h3 style="margin:0 0 4px;font-size:14px">${esc(c.razao_social)}</h3><p class="muted" style="font-size:10px">Código ${esc(c.codigo)} · ${all.length} registros históricos</p>`+(all.length?'<div class="timeline">'+all.map(e=>`<div class="event"><b>${esc(e.label)}</b><p>${esc(val(e.row,['descricao_acao','descricao','tema','sistema','tipo','especificacao','observacao']))}</p><small>${date(e.date)}</small></div>`).join('')+'</div>':'<div class="empty">Nenhum histórico vinculado.</div>')}
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>show(b.dataset.view));document.querySelectorAll('[data-goto]').forEach(b=>b.onclick=()=>show(b.dataset.goto));$('refresh').onclick=load;$('search').oninput=applyClientFilters;$('filterSituation').onchange=applyClientFilters;$('filterSegment').onchange=applyClientFilters;$('prev').onclick=()=>{if(page>1){page--;renderClients()}};$('next').onclick=()=>{if(page*pageSize<filtered.length){page++;renderClients()}};document.addEventListener('click',e=>{let b=e.target.closest('[data-open]');if(b)openProfile(b.dataset.open)});$('profileTabs').onclick=e=>{let b=e.target.closest('[data-tab]');if(b)showProfileTab(b.dataset.tab)};$('backToClients').onclick=()=>show('clientes');$('historyFind').onclick=findHistory;document.querySelectorAll('[data-table-search]').forEach(i=>i.oninput=renderDataTables);
$('saveConfig').onclick=async()=>{let url=$('supabaseUrl').value.trim().replace(/\/$/,''),key=$('supabaseKey').value.trim();if(!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(url)){toast('Informe uma Project URL válida.');return}if(!key.startsWith('sb_publishable_')){toast('Informe a chave pública sb_publishable_.');return}cfg={url,key};localStorage.setItem('central_fortes_cfg',JSON.stringify(cfg));supabaseClient=null;authSession=null;lockApp('Configuração atualizada. Entre novamente.');toast('Configuração salva. Faça login novamente para validar o acesso.')};
if(!cfg.url)cfg.url='https://gcuosgtepderzvhxlwht.supabase.co';$('supabaseUrl').value=cfg.url;$('supabaseKey').value=cfg.key||'';
$('integrationCounts').innerHTML=[{label:'Clientes',n:568},...TABLES.map(t=>({label:t.label,n:t.expected}))].map(x=>`<div class="history-item" style="padding:7px 0"><div class="history-icon">✓</div><div style="flex:1"><strong>${x.label}</strong></div><b>${x.n}</b></div>`).join('');
function lockApp(message=''){document.body.classList.add('auth-locked');authSession=null;if($('authError'))$('authError').textContent=message;$('loginUrl').value=cfg.url||'https://gcuosgtepderzvhxlwht.supabase.co';$('loginKey').value=cfg.key||'';$('loginPassword').value='';if($('userEmail'))$('userEmail').textContent=''}
async function unlockApp(session){authSession=session;document.body.classList.remove('auth-locked');$('userEmail').textContent=session.user?.email||'';$('authError').textContent='';await load()}
$('loginButton').onclick=async()=>{let url=$('loginUrl').value.trim().replace(/\/$/,''),key=$('loginKey').value.trim(),email=$('loginEmail').value.trim(),password=$('loginPassword').value;if(!/^https:\/\/[a-z0-9-]+\.supabase\.co$/i.test(url)){ $('authError').textContent='Informe uma Project URL válida.';return}if(!key.startsWith('sb_publishable_')){$('authError').textContent='Informe a chave pública sb_publishable_.';return}if(!email||!password){$('authError').textContent='Informe seu e-mail e sua senha.';return}cfg={url,key};localStorage.setItem('central_fortes_cfg',JSON.stringify(cfg));$('loginButton').disabled=true;$('loginButton').textContent='Validando acesso...';$('authError').textContent='';try{configureSupabase();let {data,error}=await supabaseClient.auth.signInWithPassword({email,password});if(error)throw error;if(!data.session)throw new Error('O Supabase não retornou uma sessão válida.');await unlockApp(data.session)}catch(e){$('authError').textContent=e.message||'Não foi possível entrar. Confira seus dados.';authSession=null;document.body.classList.add('auth-locked')}finally{$('loginButton').disabled=false;$('loginButton').textContent='Entrar na Central'}};
$('loginPassword').addEventListener('keydown',e=>{if(e.key==='Enter')$('loginButton').click()});$('loginEmail').addEventListener('keydown',e=>{if(e.key==='Enter')$('loginButton').click()});
$('logoutButton').onclick=async()=>{try{if(supabaseClient)await supabaseClient.auth.signOut()}catch(e){console.error(e)}lockApp('Você saiu da Central do Cliente.')};
if(cfg.url&&cfg.key){try{configureSupabase();supabaseClient.auth.getSession().then(({data,error})=>{if(error)throw error;if(data.session)unlockApp(data.session);else lockApp()}).catch(e=>lockApp(e.message))}catch(e){lockApp(e.message)}}else lockApp();
status(false,'Aguardando autenticação');
</script>
