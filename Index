.auth-locked>aside,.auth-locked>.main{display:none!important}.auth-gate{min-height:100vh;display:grid;place-items:center;padding:24px;background:linear-gradient(135deg,#fff 0%,#f7f2f2 100%)}body:not(.auth-locked)>.auth-gate{display:none!important}.auth-card{width:min(100%,440px);background:#fff;border:1px solid var(--line);border-radius:16px;padding:30px;box-shadow:0 16px 55px rgba(40,20,20,.09)}.auth-brand{display:flex;align-items:center;gap:12px;margin-bottom:24px}.auth-brand .brand-mark{flex:none}.auth-card h1{font-size:22px;margin:0 0 6px}.auth-card>p{font-size:12px;color:var(--muted);margin:0 0 22px}.auth-card .field{margin:12px 0}.auth-card .field input{font-size:13px;padding:12px}.auth-error{font-size:11px;color:var(--red);margin:12px 0 0;min-height:16px}.auth-help{font-size:10px;color:#888;line-height:1.5;margin-top:16px}.user-email{font-size:10px;color:var(--muted);max-width:190px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
